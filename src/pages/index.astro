---
export const prerender = true;
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import LandingLayout from '../layouts/LandingLayout.astro';
import LeadForm from '../components/custom/LeadForm.astro';
import Icon from '../components/plango/Icon.astro';
import VideoSlot from '../components/plango/VideoSlot.astro';
import PricingSection from '../components/plango/PricingSection.astro';
import siteProfile from '../config/site-profile.mjs';
import { resolveRuntimeLeadActivation } from '../config/runtime-lead-activation.mjs';
import { landingCopy } from '../content/landing-copy.ts';

// Ảnh minh họa code-native (design-src/ → src/assets/plango/, dữ liệu demo).
// astro:assets tối ưu lúc build: AVIF + srcset nhiều kích thước.
import { Image, getImage } from 'astro:assets';
import dashboardImg from '../assets/plango/dashboard.png';
import stepChatImg from '../assets/plango/step-chat.png';
import stepOptionsImg from '../assets/plango/step-options.png';
import stepConfirmImg from '../assets/plango/step-confirm.png';
import problemFilesImg from '../assets/plango/problem-files.png';
import dataSafetyImg from '../assets/plango/data-safety.png';
import beforeAfterImg from '../assets/plango/before-after.png';
import ogSource from '../assets/plango/og.png';

const { home } = siteProfile.page_copy;
const { hero, loiIch, vanDe, cachCuCachMoi, cachHoatDong, toiUu, tinhNang, tinCay, loTrinh, video, faq, lienHe } = landingCopy;

const benefitIcons = { b1: 'clock', b2: 'target', b3: 'gauge', b4: 'trend' } as const;
const featureIcons = { s1: 'gantt', s4: 'users', s5: 'alert', f1: 'calendar', f2: 'report', f3: 'sheet', f5: 'layout', f4: 'search' } as const;
const trustIcons = ['factory', 'cpu', 'check', 'shield'] as const;
const stepImages = [stepChatImg, stepOptionsImg, stepConfirmImg];

// S09 chỉ hiện khi đã có ít nhất một video ngắn được giao (docs/VIDEO_HANDOFF.md).
const shortVideos = video.items.map((item) => ({ ...item, file: `plango-${item.id}-9x16.mp4`, poster: `plango-${item.id}-9x16.jpg` }));
const hasShortVideos = shortVideos.some((item) => existsSync(join(process.cwd(), 'public', 'media', item.file)));

const leadResolution = resolveRuntimeLeadActivation({ profile: siteProfile, env: {
  LEAD_PROVIDER: import.meta.env.LEAD_PROVIDER,
  GOOGLE_SHEET_WEBHOOK_URL: import.meta.env.GOOGLE_SHEET_WEBHOOK_URL,
  WEBHOOK_SECRET: import.meta.env.WEBHOOK_SECRET,
  LEAD_ALLOWED_ORIGINS: import.meta.env.LEAD_ALLOWED_ORIGINS,
} });
if (!leadResolution.ok && leadResolution.code !== 'lead_disabled') throw new Error(leadResolution.code);
const leadEnabled = leadResolution.enabled;

// Ảnh chia sẻ (D9) — JPEG 1200×630 cho Facebook/Zalo.
const ogImage = await getImage({ src: ogSource, width: 1200, height: 630, format: 'jpeg', fit: 'cover' });

const ctaPrimary = 'relative z-[70] inline-flex min-h-[48px] items-center justify-center rounded-lg bg-brand-1 px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-brand-2';
const sectionWrap = 'mx-auto max-w-[1290px] px-4 lg:px-8';
const bodyText = 'text-[17px] leading-relaxed max-w-[65ch]';
const h2Class = 'max-w-[36ch] text-2xl font-bold tracking-tight text-brand-4 sm:text-3xl';
const arrow = 'M4 10h11m0 0-4-4m4 4-4 4';
---

<LandingLayout title={home.title} description={home.description} image={ogImage.src}>
	<main>
		{/* S01 — Hero */}
		{/* Nền gradient thay cho lớp blur: filter blur vẽ tràn ra ngoài khung làm Chrome mobile thu nhỏ trang (đo 19/10: scale 0,63 ở 375px). */}
		<section class="relative overflow-hidden bg-brand-4 bg-[radial-gradient(60%_70%_at_88%_0%,rgba(37,99,235,0.32),transparent_70%)] py-14 lg:py-20">
			<div class={`relative ${sectionWrap}`}>
				<div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
					<div class="lg:col-span-5">
						<p class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.18em] text-brand-6">
							<span class="block h-4 w-[3px] shrink-0 bg-brand-9"></span>
							{hero.eyebrow}
						</p>
						<h1 class="mt-5 text-[34px] font-extrabold leading-[1.12] tracking-tight text-white sm:text-5xl lg:text-[54px]">
							{hero.h1}
						</h1>
						<p class={`mt-6 ${bodyText} text-slate-300`}>{hero.body}</p>
						<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
							<a href={hero.ctaPrimary.href} data-cta="hero" data-korus-action="open-lead-modal" class={ctaPrimary}>{hero.ctaPrimary.label}</a>
							<a href={hero.ctaSecondary.href} data-cta="hero-pricing" class="inline-flex min-h-[48px] items-center justify-center gap-2 px-1 py-3 text-base font-semibold text-white underline-offset-4 hover:underline">
								{hero.ctaSecondary.label}
								<svg viewBox="0 0 20 20" fill="none" aria-hidden="true" class="h-4 w-4"><path d={arrow} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
							</a>
						</div>
						<p class="mt-5 flex items-center gap-2 text-sm leading-relaxed text-brand-6"><Icon name="shield" class="h-4 w-4 text-brand-9" />{hero.microcopy}</p>
					</div>
					<figure class="lg:col-span-7">
						<div class="aspect-[16/10] overflow-hidden rounded-xl border border-white/10 bg-white shadow-2xl shadow-black/40">
							<VideoSlot file="plango-hero-16x9.mp4" poster="plango-hero-16x9.jpg" label={hero.imageAlt} ambient fallback={dashboardImg} fallbackSizes="(min-width: 1024px) 58vw, 100vw" eager />
						</div>
					</figure>
				</div>
			</div>
		</section>

		{/* S01b — Lợi ích chính (b1–b4) */}
		<section id={loiIch.anchor} class="scroll-mt-24 bg-brand-8 py-16 lg:py-24">
			<div class={sectionWrap}>
				<p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-1">{loiIch.label}</p>
				<h2 class={`mt-3 ${h2Class}`}>{loiIch.h2}</h2>
				<p class={`mt-4 ${bodyText} text-brand-3`}>{loiIch.body}</p>
				<div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
					{loiIch.items.map((item) => (
						<article class="rounded-2xl border border-brand-5 bg-white p-6 shadow-sm">
							<span class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-1/10 text-brand-1"><Icon name={benefitIcons[item.id]} class="h-6 w-6" /></span>
							<h3 class="mt-5 text-xl font-bold leading-snug text-brand-4">{item.title}</h3>
							<p class="mt-3 text-[16px] leading-relaxed text-brand-3">{item.body}</p>
						</article>
					))}
				</div>
				<figure class="mt-12">
					<div class="overflow-hidden rounded-2xl border border-brand-5">
						<Image src={beforeAfterImg} alt="So sánh minh họa: xếp tay để chuyền chờ việc và quá tải, PlanGo xếp lấp khoảng trống và cân bằng tải" widths={[640, 960, 1280, 1920, 2400]} sizes="(min-width: 1290px) 1226px, 100vw" format="avif" quality={80} loading="lazy" class="h-auto w-full" />
					</div>
					<figcaption class="mt-3 text-sm text-brand-3">{loiIch.note}</figcaption>
				</figure>
			</div>
		</section>

		{/* S02 — Vấn đề */}
		<section id={vanDe.anchor} class="scroll-mt-24 bg-brand-7 py-16 lg:py-24">
			<div class={sectionWrap}>
				<div class="grid items-center gap-10 lg:grid-cols-12">
					<div class="lg:col-span-6">
						<h2 class={h2Class}>{vanDe.h2}</h2>
						<p class={`mt-4 ${bodyText} text-brand-3`}>{vanDe.body}</p>
						<ul class="mt-8 space-y-5">
							{vanDe.items.map((item) => (
								<li class="flex gap-4">
									<span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-red-50 text-red-600"><Icon name="x" class="h-5 w-5" /></span>
									<div><h3 class="text-lg font-semibold text-brand-4">{item.h3}</h3><p class="mt-1 text-[16px] leading-relaxed text-brand-3">{item.body}</p></div>
								</li>
							))}
						</ul>
					</div>
					<figure class="lg:col-span-6">
						<Image src={problemFilesImg} alt="Minh họa nhiều file Excel kế hoạch rời rạc, số liệu lệch nhau" widths={[480, 720, 960, 1440, 1920]} sizes="(min-width: 1024px) 50vw, 100vw" format="avif" quality={80} loading="lazy" class="h-auto w-full rounded-2xl" />
					</figure>
				</div>
			</div>
		</section>

		{/* S03 — Cách cũ · Cách mới */}
		<section id={cachCuCachMoi.anchor} class="scroll-mt-24 bg-brand-8 py-16 lg:py-20">
			<div class={sectionWrap}>
				<h2 class={h2Class}>{cachCuCachMoi.h2}</h2>
				<div class="mt-8 overflow-hidden rounded-2xl border border-brand-5">
					<div class="hidden grid-cols-2 bg-brand-7 text-sm font-semibold uppercase tracking-[0.12em] sm:grid">
						<p class="px-6 py-3 text-brand-3">Cách cũ</p><p class="px-6 py-3 text-brand-1">Với PlanGo</p>
					</div>
					<ul class="divide-y divide-brand-5">
						{cachCuCachMoi.rows.map((row) => (
							<li class="grid sm:grid-cols-2">
								<p class="flex items-start gap-3 px-6 py-4 text-[16px] text-brand-3"><Icon name="x" class="mt-0.5 h-5 w-5 shrink-0 text-brand-6" />{row.old}</p>
								<p class="flex items-start gap-3 bg-brand-1/5 px-6 py-4 text-[16px] font-semibold text-brand-4"><Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-brand-9" />{row.next}</p>
							</li>
						))}
					</ul>
				</div>
			</div>
		</section>

		{/* S04 — Cách hoạt động */}
		<section id={cachHoatDong.anchor} class="scroll-mt-24 bg-brand-7 py-16 lg:py-24">
			<div class={sectionWrap}>
				<h2 class={h2Class}>{cachHoatDong.h2}</h2>
				<p class={`mt-4 ${bodyText} text-brand-3`}>{cachHoatDong.body}</p>
				<ol class="mt-10 grid gap-6 lg:grid-cols-3">
					{cachHoatDong.steps.map((step, index) => (
						<li class="flex flex-col overflow-hidden rounded-2xl border border-brand-5 bg-white">
							<div class="aspect-[4/3] border-b border-brand-5">
								<Image src={stepImages[index]} alt={`${step.step}: ${step.title} — giao diện minh họa`} widths={[480, 720, 960, 1440, 1920]} sizes="(min-width: 1024px) 33vw, 100vw" format="avif" quality={80} loading="lazy" class="h-full w-full object-cover" />
							</div>
							<div class="p-6">
								<p class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.14em] text-brand-1">
									<span class="flex h-7 w-7 items-center justify-center rounded-full bg-brand-1 text-[13px] font-bold text-white">{index + 1}</span>{step.step}
								</p>
								<h3 class="mt-3 text-xl font-bold text-brand-4">{step.title}</h3>
								<p class="mt-2 text-[16px] leading-relaxed text-brand-3">{step.body}</p>
							</div>
						</li>
					))}
				</ol>
				{existsSync(join(process.cwd(), 'public', 'media', 'plango-demo-16x9.mp4')) && (
					<figure class="mx-auto mt-10 max-w-4xl">
						<div class="aspect-video overflow-hidden rounded-2xl border border-brand-5 bg-brand-4">
							<VideoSlot file="plango-demo-16x9.mp4" poster="plango-demo-16x9.jpg" label="Video demo lập kế hoạch bằng chat, dữ liệu minh họa" />
						</div>
					</figure>
				)}
				<div class="mt-10"><a href={cachHoatDong.cta.href} data-cta="cach-hoat-dong" data-korus-action="open-lead-modal" class={ctaPrimary}>{cachHoatDong.cta.label}</a></div>
			</div>
		</section>

		{/* S04b — Bộ tối ưu */}
		<section id={toiUu.anchor} class="scroll-mt-24 bg-brand-4 py-16 lg:py-24">
			<div class={sectionWrap}>
				<div class="grid gap-10 lg:grid-cols-12">
					<div class="lg:col-span-5">
						<h2 class="max-w-[30ch] text-2xl font-bold tracking-tight text-white sm:text-3xl">{toiUu.h2}</h2>
						<p class={`mt-4 ${bodyText} text-slate-300`}>{toiUu.body}</p>
						<p class="mt-6 border-l-[3px] border-brand-9 pl-4 text-[16px] leading-relaxed text-slate-300">{toiUu.note}</p>
					</div>
					<div class="lg:col-span-7">
						<ul class="grid gap-3 sm:grid-cols-2">
							{toiUu.criteria.map((item, index) => (
								<li class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/5 px-4 py-4 text-[16px] font-semibold text-white">
									<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand-1 text-sm font-bold">{index + 1}</span>{item}
								</li>
							))}
						</ul>
						<h3 class="mt-8 text-sm font-semibold uppercase tracking-[0.14em] text-brand-6">{toiUu.goalsTitle}</h3>
						<ul class="mt-3 flex flex-wrap gap-3">
							{toiUu.goals.map((goal) => (
								<li class="inline-flex items-center gap-2 rounded-full border border-white/15 px-4 py-2 text-[15px] text-white">
									<span class="flex h-6 w-6 items-center justify-center rounded-md bg-white/10 text-xs font-bold">{goal.code}</span>{goal.label}
								</li>
							))}
						</ul>
					</div>
				</div>
			</div>
		</section>

		{/* S05 — Tính năng */}
		<section id={tinhNang.anchor} class="scroll-mt-24 bg-brand-8 py-16 lg:py-24">
			<div class={sectionWrap}>
				<h2 class={h2Class}>{tinhNang.h2}</h2>
				<figure class="mt-10">
					<div class="overflow-hidden rounded-2xl border border-brand-5 shadow-sm">
						<Image src={dashboardImg} alt={tinhNang.imageAlt} widths={[640, 960, 1280, 1920, 2560, 3200]} sizes="(min-width: 1290px) 1226px, 100vw" format="avif" quality={80} loading="lazy" class="h-auto w-full" />
					</div>
				</figure>
				<div class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
					{tinhNang.items.map((item) => (
						<div>
							<span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-7 text-brand-1"><Icon name={featureIcons[item.claim]} /></span>
							<h3 class="mt-4 text-lg font-bold text-brand-4">{item.h3}</h3>
							<p class="mt-2 text-[16px] leading-relaxed text-brand-3">{item.body}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		{/* S06 — An toàn dữ liệu */}
		<section id={tinCay.anchor} class="scroll-mt-24 bg-brand-7 py-16 lg:py-24">
			<div class={sectionWrap}>
				<div class="grid items-center gap-10 lg:grid-cols-12">
					<figure class="lg:col-span-6">
						<Image src={dataSafetyImg} alt="Minh họa dữ liệu kế hoạch lưu trên máy tính tại nhà máy; trợ lý AI chỉ nhận nội dung trao đổi" widths={[480, 720, 960, 1440, 1920]} sizes="(min-width: 1024px) 50vw, 100vw" format="avif" quality={80} loading="lazy" class="h-auto w-full rounded-2xl" />
					</figure>
					<div class="lg:col-span-6">
						<h2 class={h2Class}>{tinCay.h2}</h2>
						<div class="mt-8 grid gap-6 sm:grid-cols-2">
							{tinCay.items.map((item, index) => (
								<div>
									<span class="flex h-10 w-10 items-center justify-center rounded-lg bg-white text-brand-1 shadow-sm"><Icon name={trustIcons[index]} class="h-5 w-5" /></span>
									<h3 class="mt-3 text-lg font-bold text-brand-4">{item.h3}</h3>
									<p class="mt-1 text-[16px] leading-relaxed text-brand-3">{item.body}</p>
								</div>
							))}
						</div>
					</div>
				</div>
			</div>
		</section>

		{/* S07 — Bảng giá */}
		<PricingSection />

		{/* S08 — Triển khai */}
		<section id={loTrinh.anchor} class="scroll-mt-24 bg-brand-8 py-16 lg:py-24">
			<div class={sectionWrap}>
				<h2 class={h2Class}>{loTrinh.h2}</h2>
				<p class={`mt-4 ${bodyText} text-brand-3`}>{loTrinh.body}</p>
				<div class="relative mt-12">
					<div aria-hidden="true" class="absolute left-5 top-5 bottom-5 w-0.5 bg-brand-6/40 md:left-[12.5%] md:right-[12.5%] md:top-5 md:bottom-auto md:h-0.5 md:w-auto"></div>
					<ol class="relative grid gap-8 md:grid-cols-4 md:gap-6">
						{loTrinh.steps.map((step, index) => (
							<li class="relative flex gap-5 md:block md:text-center">
								<span aria-hidden="true" class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-1 text-base font-bold text-white md:mx-auto">{index + 1}</span>
								<div class="md:mt-5">
									<p class="text-xs font-semibold uppercase tracking-[0.14em] text-brand-3">{step.step}</p>
									<h3 class="mt-1 text-xl font-semibold text-brand-4">{step.title}</h3>
									<p class="mt-2 text-[16px] leading-relaxed text-brand-3">{step.body}</p>
								</div>
							</li>
						))}
					</ol>
				</div>
				<div class="mt-12 md:text-center"><a href={loTrinh.cta.href} data-cta="trien-khai" data-korus-action="open-lead-modal" class={ctaPrimary}>{loTrinh.cta.label}</a></div>
			</div>
		</section>

		{/* S09 — Video ngắn (chỉ hiện khi đã có video giao) */}
		{hasShortVideos && (
			<section id={video.anchor} class="scroll-mt-24 bg-brand-4 py-16 lg:py-24">
				<div class={sectionWrap}>
					<h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">{video.h2}</h2>
					<div class="mt-10 grid gap-6 sm:grid-cols-3">
						{shortVideos.map((item) => (
							<figure>
								<div class="aspect-[9/16] overflow-hidden rounded-2xl border border-white/10 bg-black">
									<VideoSlot file={item.file} poster={item.poster} label={item.title} />
								</div>
								<figcaption class="mt-3 text-[15px] font-semibold text-white">{item.title}</figcaption>
							</figure>
						))}
					</div>
					<p class="mt-6 text-sm text-brand-6">{video.note}</p>
				</div>
			</section>
		)}

		{/* S10 — FAQ */}
		<section id={faq.anchor} class="scroll-mt-24 bg-brand-7 py-16 lg:py-24">
			<div class={sectionWrap}>
				<div class="mx-auto max-w-3xl">
					<h2 class="text-2xl font-bold tracking-tight text-brand-4 sm:text-3xl">{faq.h2}</h2>
					<div class="mt-8 divide-y divide-brand-5 border-y border-brand-5">
						{faq.items.map((item, index) => (
							<details class="group py-1" open={index === 0}>
								<summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-4 text-lg font-semibold text-brand-4 [&::-webkit-details-marker]:hidden">
									<span>{item.q}</span>
									<svg viewBox="0 0 20 20" fill="none" aria-hidden="true" class="mt-1.5 h-5 w-5 shrink-0 text-brand-3 transition-transform group-open:rotate-180"><path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
								</summary>
								<p class="max-w-[65ch] pb-5 text-[17px] leading-relaxed text-brand-3">{item.a}</p>
							</details>
						))}
					</div>
				</div>
			</div>
		</section>

		{/* Tương thích liên kết cũ: #contact trỏ tới khối liên hệ. */}
		<span id="contact" class="block h-0 scroll-mt-24" aria-hidden="true"></span>

		{/* S11 — Liên hệ và form (form đứng trước trong DOM để mobile thấy ngay) */}
		<section id={lienHe.anchor} class="scroll-mt-24 bg-brand-4 py-16 lg:py-24">
			<div class={sectionWrap}>
				<h2 class="max-w-[36ch] text-2xl font-bold tracking-tight text-white sm:text-3xl">{lienHe.h2}</h2>
				<div class="mt-8 grid gap-10 lg:grid-cols-12 lg:gap-12">
					<div class="lg:col-span-7 lg:order-2">
						<LeadForm leadEnabled={leadEnabled} />
					</div>
					<div class="lg:col-span-5 lg:order-1">
						<p class={`${bodyText} text-slate-300`}>{lienHe.body}</p>
						<p class="mt-4 max-w-[65ch] text-[17px] leading-relaxed text-slate-300">{lienHe.cauHoTro}</p>
						<div class="mt-8 border-t border-white/10 pt-8">
							<h3 class="text-base font-semibold text-white">{lienHe.kenhTrucTiep.title}</h3>
							<ul class="mt-3 space-y-1">
								<li>
									<a href={lienHe.kenhTrucTiep.phone.href} data-cta="contact-call" class="inline-flex min-h-[44px] items-center gap-3 text-[17px] font-semibold text-white underline-offset-4 hover:underline">

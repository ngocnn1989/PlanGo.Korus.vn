---
export const prerender = true;
import LandingLayout from '../layouts/LandingLayout.astro';
import LeadForm from '../components/custom/LeadForm.astro';
import siteProfile from '../config/site-profile.mjs';
import { resolveRuntimeLeadActivation } from '../config/runtime-lead-activation.mjs';
import { landingCopy } from '../content/landing-copy.ts';

// astro:assets tối ưu ảnh LÚC BUILD (trang prerender), sinh AVIF kèm srcset
// nhiều kích thước. Điện thoại chỉ tải bản nhỏ thay vì bản desktop. Ảnh phải
// nằm trong src/assets thì Astro mới xử lý; đặt ở public/ thì nó chỉ copy.
// Bảy ảnh trong robot-han/ là master duy nhất, mỗi ảnh dùng đúng một lần.
import { Image, getImage } from 'astro:assets';
import heroDark from '../assets/robot-han/hero-01-dark.png';
import heThongLight from '../assets/robot-han/hero-02-light.png';
import thietBiTichHop from '../assets/robot-han/support-02-integrated-equipment.png';
import ungDungDongTau from '../assets/robot-han/category-01-shipbuilding.png';
import ungDungKetCauThep from '../assets/robot-han/category-02-steel-fabrication.png';
import ungDungXuongVua from '../assets/robot-han/category-03-medium-workshop.png';
import dauHan from '../assets/robot-han/support-01-welding-head.png';

const { home } = siteProfile.page_copy;
const title = home.title;
const description = home.description;

const { hero, nenTang, heThong, ungDung, dieuKien, veVnj, loTrinh, faq, lienHe } = landingCopy;

// Chữ không có khóa riêng trong landing-copy.ts. Nguồn: docs/novabot_landing_ui.md §6.
// - cauMotHeBaBoiCanh: câu bắt buộc của S04 theo §6 và checklist §11.
const localCopy = {
  chuThichLabel: 'Các cụm chính của hệ robot',
  cauMotHeBaBoiCanh: 'Cùng một hệ robot trên ray, đặt trong ba bối cảnh sản xuất khác nhau.',
};

const ungDungImages = [ungDungDongTau, ungDungKetCauThep, ungDungXuongVua];

const leadResolution = resolveRuntimeLeadActivation({ profile: siteProfile, env: {
  LEAD_PROVIDER: import.meta.env.LEAD_PROVIDER,
  GOOGLE_SHEET_WEBHOOK_URL: import.meta.env.GOOGLE_SHEET_WEBHOOK_URL,
  WEBHOOK_SECRET: import.meta.env.WEBHOOK_SECRET,
  LEAD_ALLOWED_ORIGINS: import.meta.env.LEAD_ALLOWED_ORIGINS,
} });
if (!leadResolution.ok && leadResolution.code !== 'lead_disabled') throw new Error(leadResolution.code);
const leadEnabled = leadResolution.enabled;

// Ảnh chia sẻ mạng xã hội. Xuất JPEG chứ không WebP/AVIF: Facebook và một số
// crawler xử lý các định dạng mới không nhất quán. 1200x630 là tỷ lệ Open Graph.
const ogImage = await getImage({ src: heThongLight, width: 1200, height: 630, format: 'jpeg', fit: 'cover' });

const ctaPrimary = 'relative z-[70] inline-flex items-center justify-center rounded-lg bg-brand-1 ring-1 ring-white/50 px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-brand-2';
const sectionWrap = 'mx-auto max-w-[1290px] px-4 lg:px-8';
const bodyText = 'text-[17px] leading-relaxed max-w-[65ch]';
---

<LandingLayout title={title} description={description} image={ogImage.src}>
	<main>
		{/* S01 — Hero */}
		<section class="bg-brand-4 py-16 lg:py-20">
			<div class={sectionWrap}>
				<div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
					<div class="lg:col-span-6">
						<p class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.18em] text-brand-6">
							<span class="block h-4 w-[3px] shrink-0 bg-brand-9"></span>
							{hero.eyebrow}
						</p>
						<h1 class="mt-5 text-3xl font-bold leading-[1.15] tracking-tight text-white sm:text-4xl lg:text-5xl">
							{hero.h1}
						</h1>
						<p class={`mt-6 ${bodyText} text-brand-6`}>{hero.body}</p>
					</div>

					<figure class="lg:col-span-6 lg:row-span-2 lg:self-center">
						<div class="aspect-[16/9] overflow-hidden rounded-xl border border-white/10">
							<Image
								src={dauHan}
								alt={hero.imageAlt}
								widths={[480, 768, 1024, 1440]}
								sizes="(min-width: 1024px) 50vw, 100vw"
								format="avif"
								loading="eager"
								fetchpriority="high"
								class="h-full w-full object-cover"
							/>
						</div>
					</figure>

					<div class="lg:col-span-6">
						<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
							<a href={hero.ctaPrimary.href} data-cta="hero" data-korus-action="open-lead-modal" class={ctaPrimary}>{hero.ctaPrimary.label}</a>
							<a href={hero.ctaSecondary.href} class="inline-flex items-center justify-center gap-2 px-1 py-3 text-base font-semibold text-white underline-offset-4 hover:underline">
								{hero.ctaSecondary.label}
								<svg viewBox="0 0 20 20" fill="none" aria-hidden="true" class="h-4 w-4">
									<path d="M4 10h11m0 0-4-4m4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</a>
						</div>
						<p class="mt-5 text-sm leading-relaxed text-brand-6">{hero.microcopy}</p>
					</div>
				</div>
			</div>
		</section>

		{/* S02 — Nền tảng chế tạo máy của VN-J */}
		<section id={nenTang.anchor} class="bg-brand-7 py-10 lg:py-12">
			<div class={sectionWrap}>
				<h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-3">{nenTang.label}</h2>
				<dl class="mt-5 grid gap-4 divide-y divide-brand-6/40 md:grid-cols-3 md:gap-0 md:divide-y-0 md:divide-x">
					{nenTang.stats.map((stat, index) => (
						<div class={index === 0 ? 'md:pr-8' : 'pt-4 md:pt-0 md:px-8 last:md:pr-0'}>
							<dt class="text-2xl font-bold tracking-tight text-brand-4 lg:text-3xl">{stat.value}</dt>
							<dd class="mt-2 text-[17px] leading-relaxed text-brand-3">{stat.note}</dd>
						</div>
					))}
				</dl>
			</div>
		</section>

		{/* S03 — Cấu tạo hệ robot hàn trên ray */}
		<section id={heThong.anchor} class="scroll-mt-24 bg-brand-8 py-16 lg:py-24">
			<div class={sectionWrap}>
				<h2 class="max-w-[36ch] text-2xl font-bold tracking-tight text-brand-4 sm:text-3xl">{heThong.h2}</h2>
				<p class={`mt-4 ${bodyText} text-brand-3`}>{heThong.body}</p>

				<div class="mt-10 grid gap-8 lg:grid-cols-12">
					<div class="lg:col-span-8">
						<figure>
							<div class="relative aspect-[4/3] overflow-hidden rounded-xl border border-brand-5" data-system-diagram>
								<Image
									src={heThongLight}
									alt={heThong.imageAltChinhDien}
									widths={[480, 768, 1024, 1440]}
									sizes="(min-width: 1024px) 60vw, 100vw"
									format="avif"
									loading="lazy"
									class="h-full w-full object-cover"
								/>
							{heThong.components.map((cum, index) => (
								<a
									href={`#cum-${index + 1}`}
									data-hotspot={index + 1}
									class="hotspot absolute flex h-11 w-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full text-[13px] font-bold text-brand-4"
									style={`left:${cum.left};top:${cum.top}`}
								>
									<span aria-hidden="true" class="flex h-7 w-7 items-center justify-center rounded-full border-2 border-white bg-brand-9">{index + 1}</span>
									<span class="sr-only">{cum.label}</span>
								</a>
							))}
							</div>
							<figcaption class="mt-3 text-sm text-brand-3">{heThong.caption}</figcaption>
						</figure>
					</div>

					<div class="lg:col-span-4">
						<h3 class="text-base font-semibold text-brand-4">{localCopy.chuThichLabel}</h3>
						<ol class="mt-4 space-y-1">
							{heThong.components.map((cum, index) => (
								<li id={`cum-${index + 1}`} class="legend-item flex scroll-mt-28 items-start gap-3 rounded-lg px-3 py-2">
									<span aria-hidden="true" class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-9 text-[13px] font-bold text-brand-4">{index + 1}</span>
									<span class="text-[17px] leading-relaxed text-brand-4">{cum.label}</span>
								</li>
							))}
						</ol>
					</div>
				</div>

				<div class="mt-12 grid gap-8 lg:grid-cols-12">
					<div class="lg:col-span-5">
						<div class="space-y-7">
							{heThong.diemDocNhanh.map((diem) => (
								<div>
									<h3 class="text-xl font-semibold text-brand-4">{diem.h3}</h3>
									<p class={`mt-2 ${bodyText} text-brand-3`}>{diem.body}</p>
								</div>
							))}
						</div>
					</div>
					<div class="lg:col-span-7">
						<figure>
							<div class="aspect-[16/9] overflow-hidden rounded-xl border border-brand-5">
								<Image
									src={thietBiTichHop}
									alt={dieuKien.imageAltThayThe}
									widths={[480, 768, 1024, 1440]}
									sizes="(min-width: 1024px) 55vw, 100vw"
									format="avif"
									loading="lazy"
									class="h-full w-full object-cover"
								/>
							</div>
						</figure>
						<a href={heThong.link.href} class="mt-4 inline-flex min-h-[44px] items-center gap-2 text-base font-semibold text-brand-1 underline-offset-4 hover:underline">
							{heThong.link.label}
							<svg viewBox="0 0 20 20" fill="none" aria-hidden="true" class="h-4 w-4">
								<path d="M4 10h11m0 0-4-4m4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</a>
					</div>
				</div>

				<div class="mt-12 rounded-xl border border-brand-5 p-6 lg:p-8">
					<h3 class="text-xl font-semibold text-brand-4">{heThong.cauHinhThamChieu.title}</h3>
					<dl class="mt-5 grid gap-x-10 gap-y-0 sm:grid-cols-2">
						{heThong.cauHinhThamChieu.items.map((item) => (
							<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-brand-5 py-3">
								<dt class="text-[15px] text-brand-3">{item.label}</dt>
								<dd class="text-[15px] font-semibold text-brand-4">{item.value}</dd>
							</div>
						))}
					</dl>
					<p class="mt-5 max-w-[65ch] text-sm leading-relaxed text-brand-3">{heThong.cauHinhThamChieu.note}</p>
				</div>
			</div>
		</section>

		{/* Tương thích liên kết quảng cáo cũ: #products trỏ tới nhóm ứng dụng. */}
		<span id="products" class="block h-0 scroll-mt-24" aria-hidden="true"></span>

		{/* S04 — Ba nhóm ứng dụng */}
		<section id={ungDung.anchor} class="scroll-mt-24 bg-brand-7 py-16 lg:py-24">
			<div class={sectionWrap}>
				<h2 class="max-w-[36ch] text-2xl font-bold tracking-tight text-brand-4 sm:text-3xl">{ungDung.h2}</h2>
				<p class={`mt-4 ${bodyText} text-brand-3`}>{ungDung.body}</p>
				<p class="mt-3 max-w-[65ch] text-[17px] font-semibold leading-relaxed text-brand-4">{localCopy.cauMotHeBaBoiCanh}</p>

				<div class="mt-10 grid gap-6 md:grid-cols-3">
					{ungDung.cards.map((card, index) => (
						<article class="flex flex-col overflow-hidden rounded-xl border border-brand-5 bg-brand-8">
							<div class="aspect-[8/5] overflow-hidden border-b border-brand-5">
								<Image
									src={ungDungImages[index]}
									alt={card.imageAlt}
									widths={[480, 768, 1024, 1440]}
									sizes="(min-width: 768px) 33vw, 100vw"
									format="avif"
									loading="lazy"
									class="h-full w-full object-cover object-center"
								/>
							</div>
							<div class="flex flex-1 flex-col p-6">
								<h3 class="text-xl font-semibold text-brand-4">{card.h3}</h3>
								<p class="mt-3 text-[17px] leading-relaxed text-brand-3">{card.body}</p>
								<p class="mt-6 text-xs font-semibold uppercase tracking-[0.14em] text-brand-3">{card.listLabel}</p>
								<ul class="mt-3 space-y-2">
									{card.list.map((entry) => (
										<li class="flex gap-2 text-[15px] leading-relaxed text-brand-3">
											<span aria-hidden="true" class="mt-2.5 block h-1 w-1 shrink-0 rounded-full bg-brand-3"></span>
											<span>{entry}</span>
										</li>
									))}
								</ul>
								{/* data-ung-dung để form điền sẵn nhóm ứng dụng theo đúng thẻ khách bấm
								    (§14: điền sẵn được nhưng khách vẫn sửa được). Thiếu thuộc tính này
								    thì mọi lead từ ba thẻ đều mất trường phân loại. */}
								<a href={card.cta.href} data-cta={`card-${card.slug}`} data-ung-dung={card.slug} class="mt-auto inline-flex items-center gap-2 pt-6 text-base font-semibold text-brand-1 underline-offset-4 hover:underline">
									{card.cta.label}
									<svg viewBox="0 0 20 20" fill="none" aria-hidden="true" class="h-4 w-4">
										<path d="M4 10h11m0 0-4-4m4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								</a>
							</div>
						</article>
					))}
				</div>

				<p class="mt-8 max-w-[65ch] text-sm leading-relaxed text-brand-3">{ungDung.footnote}</p>
			</div>
		</section>

		{/* Tương thích liên kết quảng cáo cũ: #benefits trỏ tới điều kiện ứng dụng. */}
		<span id="benefits" class="block h-0 scroll-mt-24" aria-hidden="true"></span>

		{/* S05 — Điều kiện ứng dụng */}
		<section id={dieuKien.anchor} class="scroll-mt-24 bg-brand-4 py-16 lg:py-24">
			<div class={sectionWrap}>
				<h2 class="max-w-[36ch] text-2xl font-bold tracking-tight text-white sm:text-3xl">{dieuKien.h2}</h2>
				<p class={`mt-4 ${bodyText} text-brand-6`}>{dieuKien.body}</p>

				<div class="mt-10 grid gap-10 lg:grid-cols-12">
					<figure class="lg:col-span-5 lg:sticky lg:top-24 lg:self-start">
						<div class="aspect-[4/3] overflow-hidden rounded-xl border border-white/10">
							<Image
								src={heroDark}
								alt={dieuKien.imageAlt}
								widths={[480, 768, 1024, 1440]}
								sizes="(min-width: 1024px) 38vw, 100vw"
								format="avif"
								loading="lazy"
								class="h-full w-full object-cover"
							/>
						</div>
					</figure>

					<div class="space-y-8 lg:col-span-7">
						{dieuKien.items.map((item) => (
							<div class="border-l-2 border-brand-6/50 pl-5">
								<h3 class="text-xl font-semibold text-white">{item.h3}</h3>
								<p class="mt-2 max-w-[65ch] text-[17px] leading-relaxed text-brand-6">{item.body}</p>
							</div>
						))}
					</div>
				</div>

				<div class="mt-12 border-t border-white/10 pt-8">
					<p class="max-w-[65ch] text-[17px] leading-relaxed text-white">{dieuKien.cauChuyen}</p>
					<a href={dieuKien.cta.href} data-cta="dieu-kien" data-korus-action="open-lead-modal" class={`mt-5 ${ctaPrimary}`}>{dieuKien.cta.label}</a>
				</div>
			</div>
		</section>

		{/* S07 — Về VN-J */}
		<section id={veVnj.anchor} class="scroll-mt-24 bg-brand-8 py-16 lg:py-24">
			<div class={sectionWrap}>
				<div class="mx-auto max-w-[62ch]">
					<h2 class="text-2xl font-bold tracking-tight text-brand-4 sm:text-3xl">{veVnj.h2}</h2>
					<p class="mt-6 text-lg leading-relaxed text-brand-3">{veVnj.gioiThieu}</p>
					<p class="mt-5 text-lg leading-relaxed text-brand-3">{veVnj.ketNoi}</p>
					<p class="mt-8 border-l-[3px] border-brand-1 pl-5 text-lg font-medium leading-relaxed text-brand-4">{veVnj.cauNhan}</p>
					<a href={veVnj.cta.href} data-cta="ve-vnj" data-korus-action="open-lead-modal" class={`mt-8 ${ctaPrimary}`}>{veVnj.cta.label}</a>
				</div>
			</div>
		</section>

		{/* S08 — Lộ trình 4 bước */}
		<section id={loTrinh.anchor} class="scroll-mt-24 bg-brand-7 py-16 lg:py-24">
			<div class={sectionWrap}>
				<h2 class="max-w-[36ch] text-2xl font-bold tracking-tight text-brand-4 sm:text-3xl">{loTrinh.h2}</h2>
				<p class={`mt-4 ${bodyText} text-brand-3`}>{loTrinh.body}</p>

				<div class="relative mt-12">
					{/* brand-5 (#E2E8F0) trên nền brand-7 (#F1F5F9) chỉ đạt ~1.12:1 nên đường
					    nối gần như vô hình. Dùng brand-6/40 cho đúng độ nặng hairline như
					    brand-5 có trên nền trắng — cùng cách xử lý với đường chia cột ở S02. */}
					<div aria-hidden="true" class="absolute left-5 top-5 bottom-5 w-0.5 bg-brand-6/40 md:left-[12.5%] md:right-[12.5%] md:top-5 md:bottom-auto md:h-0.5 md:w-auto"></div>
					<ol class="relative grid gap-8 md:grid-cols-4 md:gap-6">
					{loTrinh.steps.map((step, index) => (
						<li class="relative flex gap-5 md:block">
							<span aria-hidden="true" class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-9 text-base font-bold text-brand-4">{index + 1}</span>
							<div class="md:mt-5">
								<p class="text-xs font-semibold uppercase tracking-[0.14em] text-brand-3">{step.step}</p>
								<h3 class="mt-1 text-xl font-semibold text-brand-4">{step.title}</h3>
								<p class="mt-2 text-[17px] leading-relaxed text-brand-3">{step.body}</p>
							</div>
						</li>
					))}
					</ol>
				</div>

				<div class="mt-12">
					<a href={loTrinh.cta.href} data-cta="lo-trinh" data-korus-action="open-lead-modal" class={ctaPrimary}>{loTrinh.cta.label}</a>
				</div>
			</div>
		</section>

		{/* S09 — FAQ */}
		<section id={faq.anchor} class="scroll-mt-24 bg-brand-8 py-16 lg:py-24">
			<div class={sectionWrap}>
				<div class="mx-auto max-w-3xl">
					<h2 class="text-2xl font-bold tracking-tight text-brand-4 sm:text-3xl">{faq.h2}</h2>
					<div class="mt-8 divide-y divide-brand-5 border-y border-brand-5">
						{faq.items.map((item, index) => (
							<details class="group py-1" open={index === 0}>
								<summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-4 text-lg font-semibold text-brand-4 [&::-webkit-details-marker]:hidden">
									<span>{item.q}</span>
									<svg viewBox="0 0 20 20" fill="none" aria-hidden="true" class="mt-1.5 h-5 w-5 shrink-0 text-brand-3 transition-transform group-open:rotate-180">
										<path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								</summary>
								<p class="max-w-[65ch] pb-5 text-[17px] leading-relaxed text-brand-3">{item.a}</p>
							</details>
						))}
					</div>
				</div>
			</div>
		</section>

		{/* Tương thích liên kết quảng cáo cũ: #contact trỏ tới khối liên hệ. */}
		<span id="contact" class="block h-0 scroll-mt-24" aria-hidden="true"></span>

		{/* S10 — Liên hệ và form */}
		<section id={lienHe.anchor} class="scroll-mt-24 bg-brand-4 py-16 lg:py-24">
			<div class={sectionWrap}>
				{/* H2 tách khỏi cột trái, và cột form đứng TRƯỚC trong DOM.
				    Mọi CTA đều nhảy tới #tu-van, nhưng ở 375px thẻ form nằm dưới mép trên
				    section 589px — người bấm CTA rơi vào một bức tường chữ, phải cuộn thêm
				    khoảng 500px nữa mới thấy ô nhập. Đảo DOM đưa form lên ngay dưới H2.
				    Desktop không đổi: lg:order-1/2 trả hai cột về đúng chỗ cũ. */}
				<h2 class="max-w-[36ch] text-2xl font-bold tracking-tight text-white sm:text-3xl">{lienHe.h2}</h2>
				<div class="mt-8 grid gap-10 lg:grid-cols-12 lg:gap-12">
					<div class="lg:col-span-7 lg:order-2">
						{/* LeadForm tự lấy chữ từ landing-copy.ts (tiêu đề, mô tả, ghi chú cuối form). */}
						{leadEnabled && <LeadForm />}
					</div>

					<div class="lg:col-span-5 lg:order-1">
						<p class={`${bodyText} text-brand-6`}>{lienHe.body}</p>
						<p class="mt-4 max-w-[65ch] text-[17px] leading-relaxed text-brand-6">{lienHe.cauHoTro}</p>

						<div class="mt-8 border-t border-white/10 pt-8">
							<h3 class="text-base font-semibold text-white">{lienHe.kenhTrucTiep.title}</h3>
							<ul class="mt-3 space-y-1">
								<li>
									<a href={lienHe.kenhTrucTiep.phone.href} class="inline-flex min-h-[44px] items-center gap-3 text-[17px] font-semibold text-white underline-offset-4 hover:underline">
										<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="h-5 w-5 shrink-0">
											<path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
										{lienHe.kenhTrucTiep.phone.label}
									</a>
								</li>
								<li>
									<a href={lienHe.kenhTrucTiep.zalo.href} rel="noopener noreferrer" target="_blank" class="inline-flex min-h-[44px] items-center gap-3 text-[17px] font-semibold text-white underline-offset-4 hover:underline">
										<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="h-5 w-5 shrink-0">
											<path d="M21 11.5a8.5 8.5 0 01-12.3 7.6L3.5 20.5l1.5-4.9A8.5 8.5 0 1121 11.5z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
										{lienHe.kenhTrucTiep.zalo.label}
									</a>
								</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
</LandingLayout>

<style>
	/* Liên kết chú thích S03. Không có JS thì chấm vẫn nhảy tới dòng chú giải
	   tương ứng; JS chỉ thêm phần làm nổi khi hover/focus. */
	.hotspot {
		transition: transform 150ms ease, box-shadow 150ms ease;
	}
	.hotspot.is-active,
	.hotspot:hover,
	.hotspot:focus-visible {
		/* Căn giữa do thuộc tính `translate` của Tailwind đảm nhiệm; ở đây chỉ
		   phóng to, nếu dùng transform: translate() nữa thì chấm bị lệch. */
		transform: scale(1.18);
		box-shadow: 0 0 0 4px rgb(245 179 0 / 0.35);
	}
	.legend-item {
		transition: background-color 150ms ease;
	}
	.legend-item.is-active {
		background-color: var(--color-brand-7);
	}
</style>

<script>
	// Chỉ là lớp tăng cường: liên kết chấm trên ảnh với dòng chú giải.
	for (const dot of document.querySelectorAll<HTMLElement>('[data-hotspot]')) {
		const item = document.getElementById(`cum-${dot.dataset.hotspot}`);
		if (!item) continue;
		const on = () => { dot.classList.add('is-active'); item.classList.add('is-active'); };
		const off = () => { dot.classList.remove('is-active'); item.classList.remove('is-active'); };
		dot.addEventListener('mouseenter', on);
		dot.addEventListener('mouseleave', off);
		dot.addEventListener('focus', on);
		dot.addEventListener('blur', off);
		item.addEventListener('mouseenter', on);
		item.addEventListener('mouseleave', off);
	}
</script>

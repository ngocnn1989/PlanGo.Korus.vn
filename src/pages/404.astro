---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteProfile from '../config/site-profile.mjs';
export const prerender = true;
const errors = siteProfile.page_copy.errors;
---
<BaseLayout title={errors.not_found_title} description={errors.not_found_body}>
  <main class="min-h-[70vh] flex items-center justify-center bg-brand-8 px-4">
    <div class="max-w-2xl mx-auto text-center">
      <h1 class="text-[120px] lg:text-[180px] font-black text-brand-1 leading-none tracking-tighter" style="text-shadow: 4px 4px 0px rgba(0,0,0,0.05);">
        404
      </h1>
      <h2 class="text-3xl font-bold text-brand-4 mt-4 uppercase tracking-wider">
        {errors.not_found_heading}
      </h2>
      <p class="text-brand-3 mt-6 mb-10 text-lg">
        {errors.not_found_body}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="bg-brand-1 text-white font-bold uppercase tracking-widest px-8 py-4 hover:bg-brand-2 transition-colors inline-block">
          {errors.home_label}
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

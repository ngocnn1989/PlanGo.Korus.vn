---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteProfile from '../config/site-profile.mjs';
export const prerender = true;
const errors = siteProfile.page_copy.errors;
---
<BaseLayout title={errors.server_title} description={errors.server_body}>
  <main class="min-h-[70vh] flex items-center justify-center bg-brand-8 px-4">
    <div class="max-w-2xl mx-auto text-center">
      <h1 class="text-[120px] lg:text-[180px] font-black text-brand-4 leading-none tracking-tighter" style="text-shadow: 4px 4px 0px rgba(230,8,8,0.1);">
        500
      </h1>
      <h2 class="text-3xl font-bold text-brand-1 mt-4 uppercase tracking-wider">
        {errors.server_heading}
      </h2>
      <p class="text-brand-3 mt-6 mb-10 text-lg">
        {errors.server_body}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center mt-10">
        <button type="button" id="server-error-retry" class="bg-brand-4 text-white font-bold uppercase tracking-widest px-8 py-4 hover:bg-black transition-colors inline-block">
          {errors.retry_label}
        </button>
        <a href="/" class="border border-brand-5 text-brand-4 font-bold uppercase tracking-widest px-8 py-4 hover:bg-brand-5 transition-colors inline-block">
          {errors.home_label}
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  document.getElementById('server-error-retry')?.addEventListener('click', () => window.location.reload());
</script>

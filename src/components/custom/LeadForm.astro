---
/**
 * S10 — Form thu nhu cầu tư vấn.
 *
 * Nguồn chữ duy nhất: `src/content/landing-copy.ts` khóa `lienHe`
 * (dựng từ docs/novabot_landing.md §14 và docs/novabot_landing_ui.md §6).
 * Không viết chữ cứng trong file này để form và modal không trôi thành hai bản.
 *
 * Bốn trạng thái bắt buộc: đang gửi / thành công / lỗi xác định /
 * chưa rõ kết quả do gián đoạn kết nối.
 */
import { landingCopy } from '../../content/landing-copy';

export interface Props {
  title?: string;
  subtitle?: string;
}

const lienHe = landingCopy.lienHe;
const { title = lienHe.formTitle, subtitle = lienHe.formBody } = Astro.props;

/** Tra nhãn/placeholder theo tên trường, giữ một nguồn chữ. */
const field = (name: string) => lienHe.fields.find((item) => item.name === name)!;

/**
 * Tách câu thông báo đồng ý quanh nhãn liên kết để chèn thẻ <a> mà không chép
 * lại chữ. Nguồn vẫn là `lienHe.consent`, không có bản sao thứ hai trong
 * markup. Từ 2026-09-10 đây là câu TĨNH đặt dưới nút gửi, không còn ô tick:
 * hành vi gửi form chính là hành vi đồng ý, và `consent_at` phía máy chủ lấy
 * theo thời điểm gửi.
 */
const consentParts = lienHe.consent.split(lienHe.consentLink.label);
const consentBefore = consentParts[0] ?? lienHe.consent;
const consentAfter = consentParts.slice(1).join(lienHe.consentLink.label);

const formId = `lead-form-${Math.random().toString(36).slice(2, 10)}`;
const id = (suffix: string) => `${formId}-${suffix}`;
---

<div class="lead-form-wrapper" data-form-id={formId}>
  <form
    id={formId}
    novalidate
    class="lead-card w-full bg-white rounded-2xl p-5 sm:p-6 md:p-7 text-left shadow-xl"
    data-msg-missing-name={lienHe.validation.missingName}
    data-msg-missing-phone={lienHe.validation.missingPhone}
    data-msg-invalid-phone={lienHe.validation.invalidPhone}
    data-msg-phone-has-letters={lienHe.validation.phoneHasLetters}
    data-msg-phone-too-short={lienHe.validation.phoneTooShort}
    data-msg-phone-too-long={lienHe.validation.phoneTooLong}
    data-msg-invalid-email={lienHe.validation.invalidEmail}
    data-msg-multiple={lienHe.validation.multiple}
  >
    <div class="mb-5">
      <h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-1">{title}</h3>
      <p class="text-sm text-gray-600">{subtitle}</p>
    </div>

    {/* Tóm tắt khi có lỗi ở nhiều trường. */}
    <p
      class="lead-summary hidden items-start gap-2 mb-4 rounded-lg px-3 py-2 text-sm"
      role="alert"
      id={id('summary')}
    >
      <svg class="lead-icon shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" /></svg>
      <span class="lead-summary-text"></span>
    </p>

    <div class="space-y-4">
      {/* Trường bắt buộc — luôn hiển thị. */}
      <div class="lead-field" data-field="name">
        <label for={id('name')} class="block text-sm font-medium text-gray-800 mb-1">
          {field('name').label}
          <span class="lead-required" aria-hidden="true">*</span>
        </label>
        <input
          id={id('name')}
          class="lead-input"
          type="text"
          name="name"
          autocomplete="name"
          maxlength="120"
          required
          placeholder={field('name').placeholder}
        />
        <p id={id('name-error')} class="lead-error hidden" hidden>
          <svg class="lead-icon shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" /></svg>
          <span class="lead-error-text"></span>
        </p>
      </div>

      <div class="lead-field" data-field="phone">
        <label for={id('phone')} class="block text-sm font-medium text-gray-800 mb-1">
          {field('phone').label}
          <span class="lead-required" aria-hidden="true">*</span>
        </label>
        <input
          id={id('phone')}
          class="lead-input"
          type="tel"
          name="phone"
          inputmode="tel"
          autocomplete="tel"
          maxlength="40"
          required
          aria-describedby={id('phone-hint')}
          placeholder={field('phone').placeholder}
        />
        {/* Gợi ý định dạng hiện SẴN, không đợi khách nhập sai rồi mới báo. */}
        <p id={id('phone-hint')} class="mt-1 text-xs text-gray-500">{lienHe.phoneHint}</p>
        <p id={id('phone-error')} class="lead-error hidden" hidden>
          <svg class="lead-icon shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" /></svg>
          <span class="lead-error-text"></span>
        </p>
      </div>

      {/* Bốn trường tùy chọn. Mở sẵn khi khách đến từ thẻ ứng dụng. */}
      <details class="lead-extra rounded-lg border border-gray-200 bg-gray-50/60">
        <summary class="lead-extra-summary cursor-pointer select-none px-3 py-3 text-sm font-medium text-gray-800">
          {lienHe.mobileGroupLabel}
        </summary>

        <div class="space-y-4 px-3 pb-4 pt-1">
          <div class="lead-field" data-field="company">
            <label for={id('company')} class="block text-sm font-medium text-gray-800 mb-1">
              {field('company').label}
            </label>
            <input
              id={id('company')}
              class="lead-input"
              type="text"
              name="company"
              autocomplete="organization"
              maxlength="120"
              placeholder={field('company').placeholder}
            />
          </div>

          <div class="lead-field" data-field="application">
            <label for={id('application')} class="block text-sm font-medium text-gray-800 mb-1">
              {field('application').label}
            </label>
            <select id={id('application')} class="lead-input" name="application">
              <option value="">{field('application').placeholder}</option>
              {lienHe.applicationOptions.map((option) => (
                <option value={option.value}>{option.label.replace(/\.$/, '')}</option>
              ))}
            </select>
          </div>

          <div class="lead-field" data-field="message">
            <label for={id('message')} class="block text-sm font-medium text-gray-800 mb-1">
              {field('message').label}
            </label>
            <textarea
              id={id('message')}
              class="lead-input lead-textarea"
              name="message"
              rows="3"
              maxlength="2000"
              aria-describedby={id('message-hint')}
              placeholder={field('message').placeholder}
            ></textarea>
            <p id={id('message-hint')} class="mt-1 text-xs text-gray-500">{lienHe.messageHint}</p>
          </div>

          <div class="lead-field" data-field="email">
            <label for={id('email')} class="block text-sm font-medium text-gray-800 mb-1">
              {field('email').label}
            </label>
            <input
              id={id('email')}
              class="lead-input"
              type="email"
              name="email"
              autocomplete="email"
              maxlength="254"
              placeholder={field('email').placeholder}
            />
            <p id={id('email-error')} class="lead-error hidden" hidden>
              <svg class="lead-icon shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" /></svg>
              <span class="lead-error-text"></span>
            </p>
          </div>
        </div>
      </details>

      {/* Bẫy bot: input chữ đặt ngoài khung nhìn, người dùng thật không thấy. */}
      <div class="lead-trap" aria-hidden="true">
        <input type="text" name="bot_trap" tabindex="-1" value="" autocomplete="off" />
      </div>

      {/* Trạng thái 3 — lỗi được xác định là chưa gửi thành công. */}
      <div class="lead-state lead-state-error hidden rounded-lg p-3" data-state="error" role="alert" tabindex="-1" hidden>
        <p class="text-sm font-bold">{lienHe.states.error.title}</p>
        <p class="mt-1 text-sm">{lienHe.states.error.body}</p>
        <p class="mt-2 text-sm">
          <a href={lienHe.kenhTrucTiep.phone.href} class="inline-block -my-[13px] py-[13px] font-medium underline">{lienHe.kenhTrucTiep.phone.label}</a>
          <span aria-hidden="true"> · </span>
          <a href={lienHe.kenhTrucTiep.zalo.href} class="inline-block -my-[13px] py-[13px] font-medium underline">{lienHe.kenhTrucTiep.zalo.label}</a>
        </p>
      </div>

      {/* Trạng thái 4 — mất kết nối, chưa xác nhận được kết quả gửi. */}
      <div class="lead-state lead-state-unknown hidden rounded-lg p-3" data-state="unknown" role="alert" tabindex="-1" hidden>
        <p class="text-sm font-bold">{lienHe.states.unknown.title}</p>
        <p class="mt-1 text-sm">{lienHe.states.unknown.bodyKhongKiemTraTrangThai}</p>
        <p class="mt-2 text-sm">
          <a href={lienHe.kenhTrucTiep.phone.href} class="inline-block -my-[13px] py-[13px] font-medium underline">{lienHe.kenhTrucTiep.phone.label}</a>
        </p>
      </div>

      <button
        type="submit"
        class="lead-submit relative z-[70] w-full h-12 bg-brand-1 text-white rounded-lg font-bold text-base hover:bg-brand-2 transition-colors disabled:opacity-70 disabled:cursor-not-allowed"
        data-label-idle={lienHe.submit}
        data-label-sending={lienHe.states.sending.submit}
        data-label-retry={lienHe.states.error.retry}
      >{lienHe.submit}</button>

      {/* Thông báo đồng ý — tĩnh, ngay dưới nút gửi. Không có ô tick. */}
      <p class="lead-consent-notice text-sm leading-snug text-brand-3">
        {consentBefore}<a
          href={lienHe.consentLink.href}
          class="inline-block -my-[13px] py-[13px] underline hover:text-brand-1"
        >{lienHe.consentLink.label}</a>{consentAfter}
      </p>

      <p class="text-xs leading-snug text-gray-500">{lienHe.note}</p>
    </div>
  </form>

  {/* Trạng thái 2 — chỉ hiện khi phía tiếp nhận xác nhận đã nhận yêu cầu. */}
  <div
    class="lead-form-success hidden w-full bg-white rounded-2xl p-6 md:p-8 text-left shadow-xl"
    role="status"
    tabindex="-1"
    hidden
  >
    <div class="mb-3 flex h-11 w-11 items-center justify-center rounded-full bg-green-100">
      <svg class="h-6 w-6 text-green-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" /></svg>
    </div>
    <h3 class="text-xl font-bold text-gray-900 mb-2">{lienHe.states.success.title}</h3>
    <p class="text-sm text-gray-700">{lienHe.states.success.body}</p>
    <p class="mt-2 text-sm text-gray-700">{lienHe.states.success.extra}</p>
    <div class="mt-4 flex flex-wrap gap-3">
      {lienHe.states.success.actions.map((action) => (
        <a
          href={action.href}
          class="inline-flex h-11 items-center rounded-lg border border-brand-1 px-4 text-sm font-bold text-brand-1 hover:bg-brand-1 hover:text-white transition-colors"
        >{action.label}</a>
      ))}
    </div>
  </div>
</div>


<script>
  import { trackConversion, trackFormStart } from '../../utils/tracking';

  // Chữ thông báo lỗi đi qua data-attribute chứ không import landing-copy vào
  // bundle client: nguồn chữ vẫn là landing-copy.ts, nhưng trang không phải
  // tải toàn bộ copy của mọi section.

  // Khớp với PHONE_PATTERN phía máy chủ (src/utils/lead-request.ts): cho phép
  // chữ số, dấu +, dấu chấm, dấu ngoặc, gạch nối và khoảng trắng. Không áp
  // thêm quy tắc riêng để tránh loại nhầm số hợp lệ có mã quốc gia.
  const PHONE_ALLOWED = /^[0-9+().\s-]+$/;
  const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  // Prefill nhóm ứng dụng: chấp nhận cả slug tiếng Anh trong copy lẫn slug
  // tiếng Việt mà thẻ ứng dụng có thể dùng.
  const APPLICATION_ALIASES: Record<string, string> = {
    'dong-tau': 'shipbuilding',
    'ket-cau-lon': 'shipbuilding',
    'ket-cau-thep': 'structural-steel',
    'co-khi-che-tao': 'structural-steel',
    'co-khi-chinh-xac': 'precision-fabrication',
    'khac': 'other',
    'chua-xac-dinh': 'undecided',
  };

  // Giữ nguyên trong suốt một lượt điền form để lần thử lại không tạo lead trùng.
  let pendingIdempotencyKey = '';

  function newIdempotencyKey(): string {
    const uuid = globalThis.crypto?.randomUUID?.();
    if (uuid) return uuid;
    const bytes = new Uint8Array(16);
    globalThis.crypto?.getRandomValues?.(bytes);
    return Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('');
  }

  /**
   * Trả về null nếu hợp lệ, hoặc thông báo nói RÕ sai chỗ nào.
   *
   * Bản cũ chỉ trả true/false nên mọi nguyên nhân đều hiện chung một câu
   * "Vui lòng kiểm tra lại số điện thoại." — khách không biết mình thiếu số,
   * thừa số hay gõ nhầm chữ, và thường bỏ cuộc thay vì sửa.
   *
   * Quy tắc cố ý rộng: mọi ký tự trang trí đều bỏ qua, `+84`/`84` quy về `0`,
   * và số có mã quốc gia khác vẫn được chấp nhận. Thà nhận một số hơi lạ còn
   * hơn chặn một khách thật.
   */
  function checkPhone(value: string, validation: {
    phoneHasLetters: string; invalidPhone: string; phoneTooShort: string; phoneTooLong: string;
  }): string | null {
    if (!PHONE_ALLOWED.test(value)) return validation.phoneHasLetters;

    let digits = value.replace(/\D/g, '');
    const isInternational = value.trim().startsWith('+') && !/^\+?84/.test(value.trim());

    // Quy +84 / 84 về 0 để đếm chữ số theo cùng một thước với số trong nước.
    if (!isInternational) digits = digits.replace(/^84/, '0');

    if (isInternational) {
      return digits.length >= 7 && digits.length <= 15 ? null : validation.invalidPhone;
    }
    if (digits.length < 9) return validation.phoneTooShort;
    if (digits.length > 12) return validation.phoneTooLong;
    return null;
  }

  document.querySelectorAll<HTMLElement>('.lead-form-wrapper').forEach((wrapper) => {
    const formId = wrapper.getAttribute('data-form-id');
    if (!formId) return;
    const form = document.getElementById(formId) as HTMLFormElement | null;
    if (!form) return;

    const summary = form.querySelector<HTMLElement>('.lead-summary');
    const summaryText = form.querySelector<HTMLElement>('.lead-summary-text');
    const submitBtn = form.querySelector<HTMLButtonElement>('.lead-submit');
    const errorPanel = form.querySelector<HTMLElement>('[data-state="error"]');
    const unknownPanel = form.querySelector<HTMLElement>('[data-state="unknown"]');
    const details = form.querySelector<HTMLDetailsElement>('.lead-extra');
    const applicationSelect = form.querySelector<HTMLSelectElement>('select[name="application"]');

    const validation = {
      missingName: form.dataset.msgMissingName || '',
      missingPhone: form.dataset.msgMissingPhone || '',
      invalidPhone: form.dataset.msgInvalidPhone || '',
      phoneHasLetters: form.dataset.msgPhoneHasLetters || form.dataset.msgInvalidPhone || '',
      phoneTooShort: form.dataset.msgPhoneTooShort || form.dataset.msgInvalidPhone || '',
      phoneTooLong: form.dataset.msgPhoneTooLong || form.dataset.msgInvalidPhone || '',
      invalidEmail: form.dataset.msgInvalidEmail || '',
      multiple: form.dataset.msgMultiple || '',
    };

    const labelIdle = submitBtn?.dataset.labelIdle || '';
    const labelSending = submitBtn?.dataset.labelSending || '';
    const labelRetry = submitBtn?.dataset.labelRetry || '';

    // Chặn gửi lặp trong lúc cùng một yêu cầu đang xử lý.
    let sending = false;

    const show = (element: HTMLElement | null | undefined) => {
      if (!element) return;
      element.hidden = false;
      element.classList.remove('hidden');
    };

    const hide = (element: HTMLElement | null | undefined) => {
      if (!element) return;
      element.hidden = true;
      element.classList.add('hidden');
    };

    const control = (name: string) =>
      form.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(`[name="${name}"]`);

    const errorNode = (name: string) => document.getElementById(`${formId}-${name}-error`);

    function clearFieldError(name: string) {
      const input = control(name);
      const node = errorNode(name);
      if (input) {
        input.classList.remove('is-invalid');
        input.removeAttribute('aria-invalid');
        const described = (input.getAttribute('aria-describedby') || '')
          .split(/\s+/)
          .filter((token) => token && token !== `${formId}-${name}-error`)
          .join(' ');
        if (described) input.setAttribute('aria-describedby', described);
        else input.removeAttribute('aria-describedby');
      }
      if (node) {
        const text = node.querySelector('.lead-error-text');
        if (text) text.textContent = '';
        hide(node);
      }
    }

    function setFieldError(name: string, message: string) {
      const input = control(name);
      const node = errorNode(name);
      if (input) {
        input.classList.add('is-invalid');
        input.setAttribute('aria-invalid', 'true');
        const described = (input.getAttribute('aria-describedby') || '').split(/\s+/).filter(Boolean);
        if (!described.includes(`${formId}-${name}-error`)) described.push(`${formId}-${name}-error`);
        input.setAttribute('aria-describedby', described.join(' '));
      }
      if (node) {
        const text = node.querySelector('.lead-error-text');
        if (text) text.textContent = message;
        show(node);
      }
    }

    function clearAllErrors() {
      for (const name of ['name', 'phone', 'email']) clearFieldError(name);
      if (summaryText) summaryText.textContent = '';
      hide(summary);
    }

    /** Trả về danh sách trường lỗi theo đúng thứ tự xuất hiện trên form. */
    function validate(): string[] {
      const failed: string[] = [];
      const name = (control('name') as HTMLInputElement | null)?.value.trim() || '';
      const phone = (control('phone') as HTMLInputElement | null)?.value.trim() || '';
      const email = (control('email') as HTMLInputElement | null)?.value.trim() || '';

      if (!name) {
        setFieldError('name', validation.missingName);
        failed.push('name');
      }

      if (!phone) {
        setFieldError('phone', validation.missingPhone);
        failed.push('phone');
      } else {
        const phoneError = checkPhone(phone, validation);
        if (phoneError) {
          setFieldError('phone', phoneError);
          failed.push('phone');
        }
      }

      if (email && !EMAIL_PATTERN.test(email)) {
        setFieldError('email', validation.invalidEmail);
        failed.push('email');
      }

      return failed;
    }

    function focusFirstError(failed: string[]) {
      const first = failed[0];
      if (!first) return;
      // Lỗi nằm trong phần mở rộng thì phải mở ra, nếu không focus rơi vào
      // phần tử đang ẩn và khách không thấy lỗi ở đâu.
      const input = control(first);
      if (details && input && details.contains(input)) details.open = true;
      input?.focus();
    }

    function setSending(active: boolean) {
      sending = active;
      if (!submitBtn) return;
      submitBtn.disabled = active;
      submitBtn.setAttribute('aria-busy', active ? 'true' : 'false');
      if (active) submitBtn.textContent = labelSending;
    }

    function prefillApplication() {
      if (!applicationSelect) return;
      const search = new URLSearchParams(window.location.search);
      const hash = window.location.hash.slice(1);
      const hashQuery = hash.includes('?') ? new URLSearchParams(hash.slice(hash.indexOf('?') + 1)) : null;
      const raw = search.get('ung-dung') || hashQuery?.get('ung-dung') || '';
      if (!raw) return;

      const slug = raw.trim().toLowerCase();
      const value = APPLICATION_ALIASES[slug] || slug;
      const matched = Array.from(applicationSelect.options).some((option) => option.value === value);
      // Khách vẫn sửa được: chỉ điền sẵn, không khóa lựa chọn.
      if (matched) applicationSelect.value = value;
      if (details) details.open = true;
    }

    prefillApplication();
    window.addEventListener('hashchange', prefillApplication);
    // Thẻ ứng dụng có thể gắn data-ung-dung thay vì đổi URL.
    document.addEventListener('click', (event) => {
      const trigger = event.target instanceof Element ? event.target.closest('[data-ung-dung]') : null;
      if (!trigger || !applicationSelect) return;
      const slug = (trigger.getAttribute('data-ung-dung') || '').trim().toLowerCase();
      const value = APPLICATION_ALIASES[slug] || slug;
      if (Array.from(applicationSelect.options).some((option) => option.value === value)) {
        applicationSelect.value = value;
      }
      if (details) details.open = true;
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending) return;

      hide(errorPanel);
      hide(unknownPanel);
      clearAllErrors();

      const trap = form.querySelector<HTMLInputElement>('input[name="bot_trap"]');
      if (trap && trap.value.trim().length > 0) return;

      const failed = validate();
      if (failed.length > 0) {
        if (failed.length > 1 && summary && summaryText) {
          summaryText.textContent = validation.multiple;
          show(summary);
        }
        focusFirstError(failed);
        return;
      }

      setSending(true);

      // Không tự gửi lại sau timeout: hết thời gian chỉ chuyển sang trạng thái
      // "chưa xác nhận được", để khách tự quyết định.
      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), 20000);

      let response: Response | null = null;
      try {
        // Key giữ nguyên cho mọi lần thử lại của CÙNG một lượt điền form. Bản cũ
        // sinh key mới ở mỗi fetch, nên kịch bản "máy chủ đã nhận nhưng trình
        // duyệt mất kết nối → khách bấm Thử gửi lại" tạo hai dòng cho một khách.
        // Chỉ cấp key mới sau khi gửi thành công (xem chỗ đặt lại bên dưới).
        if (!pendingIdempotencyKey) pendingIdempotencyKey = newIdempotencyKey();
        response = await fetch('/api/leads', {
          method: 'POST',
          headers: { 'Idempotency-Key': pendingIdempotencyKey },
          body: new FormData(form),
          signal: controller.signal,
        });
      } catch {
        // Không nhận được phản hồi: máy chủ có thể đã nhận nhưng trình duyệt
        // không biết. Đây là trạng thái 4, không phải lỗi từ chối.
        window.clearTimeout(timer);
        setSending(false);
        if (submitBtn) submitBtn.textContent = labelIdle;
        show(unknownPanel);
        unknownPanel?.focus();
        return;
      }
      window.clearTimeout(timer);

      const result = await response.json().catch(() => null);
      setSending(false);

      // Thành công chỉ khi phía tiếp nhận xác nhận, không phải vì đã bấm nút.
      if (response.ok && result && result.success === true) {
        pendingIdempotencyKey = '';
        if (typeof result.receiptId === 'string' && result.receiptId.trim().length > 0) {
          trackConversion('submit_success', {}, result.receiptId);
        }
        // Chuyển thẳng sang trang cảm ơn, KHÔNG hiện màn hình thành công trung
        // gian. Sự kiện chuyển đổi đã được đẩy vào dataLayer ở trên; GA4/Meta
        // gửi hit qua sendBeacon nên vẫn kịp trước khi trình duyệt rời trang.
        window.location.assign('/thank-you/');
        return;
      }

      if (submitBtn) submitBtn.textContent = labelRetry;
      show(errorPanel);
      errorPanel?.focus();
    });

    // Xóa lỗi ngay khi khách sửa, tránh để chữ đỏ đứng lại sai.
    for (const name of ['name', 'phone', 'email']) {
      control(name)?.addEventListener('input', () => clearFieldError(name));
    }

    // docs/novabot_landing.md §21 — "Form bắt đầu". Chỉ ghi nhận khi khách
    // thực sự nhập/chọn, không phải khi trang tải, khi form lọt vào khung
    // nhìn, hay khi khách chỉ focus rồi rời đi. Cờ một-lần nằm trong
    // trackFormStart nên mọi form trên trang chia chung một lần bắn.
    // Không gắn dữ liệu khách nhập vào sự kiện.
    const emitFormStart = () => trackFormStart();
    form.addEventListener('input', emitFormStart);
    form.addEventListener('change', emitFormStart);
  });
</script>
